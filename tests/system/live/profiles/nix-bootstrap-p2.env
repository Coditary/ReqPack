# Plugin must bootstrap Nix via context.net.download (no distro nix package in image).
SYSTEM="nix"
PLUGIN_ID="nix"
PKG_RQP_ARTIFACT="/workspace/artifacts/nix.rqp"
PKG_LOCAL_V1="/workspace/live-fixtures/nix/placeholder-unimplemented"
PKG_LOCAL_V2="/workspace/live-fixtures/nix/placeholder-unimplemented-v2"
PKG_NAME="hello"
PKG_REMOTE_VALID="hello"
PKG_NONEXISTENT="reqpack-definitely-does-not-exist-99999"
PKG_BAD_VERSION="999.999.999"
ARCH_VALID="x86_64-linux"
ARCH_INVALID="sparc64-invalid"
CONFORMANCE_PHASE="p2"
NIX_CONFORMANCE_SKIP_PREWARM=1
NIX_CONFORMANCE_REQUIRES_PLUGIN_BOOTSTRAP=1
CONF_PLUGIN_DIR="/workspace/plugins"
