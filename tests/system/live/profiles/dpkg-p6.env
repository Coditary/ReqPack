# dpkg — Phase 6 conformance (sbom, audit, snapshot; runs P1–P5 bootstrap)
SYSTEM="dpkg"
PLUGIN_ID="dpkg"
PKG_RQP_ARTIFACT="/workspace/artifacts/dpkg.rqp"
PKG_LOCAL_V1="/workspace/live-fixtures/debian/reqpack-live-fixture_1.0_all.deb"
PKG_LOCAL_V2="/workspace/live-fixtures/debian/reqpack-live-fixture_2.0_all.deb"
PKG_LOCAL_CORRUPT="/workspace/live-fixtures/corrupt/corrupt.deb"
PKG_NAME="reqpack-live-fixture"
PKG_REMOTE_VALID="tree"
PKG_NONEXISTENT="reqpack-definitely-does-not-exist-99999"
PKG_BAD_VERSION="999.999.999"
ARCH_VALID="all"
ARCH_INVALID="sparc64-invalid"
PKG_VERIFY_CMD="command -v rqplive-fixture"
PKG_VERSION_V1="1.0"
PKG_VERSION_V2="2.0"
CONFORMANCE_PHASE="p6"
CONF_PLUGIN_DIR="/workspace/plugins"
PKG_VERIFY_VERSION_CMD='dpkg-query -W -f='\''${Version}'\'' reqpack-live-fixture 2>/dev/null | grep -Fxq 2.0'
