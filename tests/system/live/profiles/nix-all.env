# Nix — full conformance (P1–P7, remote nixpkgs + P3 bootstrap hello store path)
SYSTEM="nix"
PLUGIN_ID="nix"
PKG_RQP_ARTIFACT="/workspace/artifacts/nix.rqp"
PKG_LOCAL_V1="/workspace/live-fixtures/nix/hello-store"
PKG_LOCAL_V2="/workspace/live-fixtures/nix/placeholder-unimplemented-v2"
PKG_LOCAL_CORRUPT="/workspace/live-fixtures/corrupt/corrupt.tgz"
PKG_NAME="hello"
PKG_REMOTE_VALID="hello"
PKG_NONEXISTENT="reqpack-definitely-does-not-exist-99999"
PKG_BAD_VERSION="999.999.999"
ARCH_VALID="x86_64-linux"
ARCH_INVALID="sparc64-invalid"
PKG_VERIFY_CMD="command -v hello"
PKG_VERSION_V1="1.0"
PKG_VERSION_V2="2.0"
CONFORMANCE_PHASE="all"
CONF_PLUGIN_DIR="/workspace/plugins"
CONFORMANCE_SKIP_P4_GROUP=1
CONFORMANCE_SKIP_P5_UPDATE_V2=1
CONFORMANCE_AUDIT_UNSAFE_ID="CVE-2026-REQPACK-NIX-CONFORMANCE"
