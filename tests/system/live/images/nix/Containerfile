# Nix live tests on Fedora (matches Fedora-built rqp bundles for this row).
FROM fedora:44

RUN dnf install -y \
        bash \
        ca-certificates \
        curl \
        jq \
        xz \
        git \
        nix \
    && dnf -y makecache

ENV NIX_CONFIG="experimental-features = nix-command flakes"

RUN mkdir -p /etc/nix && \
    printf '%s\n' \
      'experimental-features = nix-command flakes' \
      'sandbox = false' \
      >> /etc/nix/nix.conf

WORKDIR /workspace
